# Placeholders only. Copy to .env.local or set these in the host. Do not commit real values.
# Older names still work. When both are set, the GBM_ name wins.

# Site password. Unset in demo mode (no DATABASE_URL, or GBM_DEMO=1) leaves the sample inbox open.
GBM_SITE_PASSWORD=
APP_PASSWORD=

# Signs the session cookie. Required to lock the site with a password.
GBM_SESSION_SECRET=
SESSION_SECRET=

# Bearer token for POST /api/ingest, GET /api/ingest/state, and the bot outbox routes.
GBM_INGEST_TOKEN=
INGEST_TOKEN=

# Neon Postgres. Leave unset for sample mail. Migrations prefer the unpooled URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional non-negative integer. Missing or invalid values use 1. Raise it to revoke cookies.
SESSION_VERSION=

# Optional mailbox identity. Unset keeps the ingest account, then the neutral default.
GBM_OWNER_NAME=
GBM_INBOX_ADDRESS=
# Comma-separated plus tags. Optional label after a colon. Example: ops,books:Reading
GBM_TAGS=

# 1 forces sample mail even when DATABASE_URL is set. 0 uses the database (PGLite if no URL).
GBM_DEMO=

# Bot scripts. The bot keeps the ingest token in ~/.config/grokbot-mail/ with chmod 600 and never prints it.
GBM_APP_ORIGIN=
GBM_INGEST_URL=
GBM_INGEST_PATH=
GBM_INGEST_FILE=
